rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // A user owns the whole tree below /users/{uid}. Every read and write must
    // stay inside that tree; there is no top-level collection rule because the
    // client never writes outside /users/{uid}.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /{collection}/{document} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;

        match /{nested=**} {
          allow read, write: if isSignedIn() && request.auth.uid == userId;
        }
      }
    }
  }
}
